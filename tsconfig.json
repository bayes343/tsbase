{
  "compilerOptions": {
    "target": "es2018",
    "module": "NodeNext",
    "lib": [
      "dom",
      "es2018",
      "webworker"
    ],
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "importHelpers": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": [
      "jest",
      "node"
    ],
    "esModuleInterop": true,
    "inlineSources": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "jsxFactory": "ParseJsx",
    "jsxFragmentFactory": "Fragment",
    "skipLibCheck": true
  },
  "exclude": [
    "./playground.ts",
    "./addPlaygroundScript.ts",
    "./dist"
  ]
}
